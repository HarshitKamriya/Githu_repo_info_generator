{
  "name": "repo-info-generator",
  "version": "1.0.0",
  "description": "Generate comprehensive info.md summaries for any GitHub repository",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "install:client": "cd client && npm install",
    "build:client": "cd client && npm run build",
    "build": "npm run install:client && npm run build:client"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["github", "repository", "markdown", "generator"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  }
}
